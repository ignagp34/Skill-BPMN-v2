<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             id="Definitions_1"
             targetNamespace="http://example.com/bpmn">
  <process id="Process_1" isExecutable="true">
    <startEvent id="Start_1" name="Start"/>
    <!-- AND split matched with AND join -->
    <parallelGateway id="AND_split" name="Fork"/>
    <task id="Task_A" name="A"/>
    <task id="Task_B" name="B"/>
    <parallelGateway id="AND_join" name="Join"/>
    <endEvent id="End_1" name="End"/>

    <sequenceFlow id="F1" sourceRef="Start_1" targetRef="AND_split"/>
    <sequenceFlow id="F2" sourceRef="AND_split" targetRef="Task_A"/>
    <sequenceFlow id="F3" sourceRef="AND_split" targetRef="Task_B"/>
    <sequenceFlow id="F4" sourceRef="Task_A" targetRef="AND_join"/>
    <sequenceFlow id="F5" sourceRef="Task_B" targetRef="AND_join"/>
    <sequenceFlow id="F6" sourceRef="AND_join" targetRef="End_1"/>
  </process>
</definitions>
