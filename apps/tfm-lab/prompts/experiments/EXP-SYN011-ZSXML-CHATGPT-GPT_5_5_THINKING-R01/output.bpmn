<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  id="Definitions_SYN011"
                  targetNamespace="http://example.com/bpmn/SYN011">
  <bpmn:collaboration id="Collaboration_SYN011">
    <bpmn:participant id="Participant_Agency" name="Public Administration Agency" processRef="Process_SYN011"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_SYN011" name="Public Grant Application Review" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Agency">
      <bpmn:lane id="Lane_Officer" name="Officer">
        <bpmn:flowNodeRef>StartEvent_ApplicationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckApplicationForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewBudgetFile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConsultEligibilityRules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApplicationComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordIssue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendCompletionRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CompletionRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteEvaluationReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StoreReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IssueRecommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_RecommendationIssued</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ApplicationReceived" name="Application form and budget file received">
      <bpmn:outgoing>Flow_Start_Register</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RegisterApplication" name="Register application in grants database">
      <bpmn:incoming>Flow_Start_Register</bpmn:incoming>
      <bpmn:outgoing>Flow_Register_CheckForm</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInputAssociation_Form_Register">
        <bpmn:sourceRef>DataObjectReference_ApplicationForm</bpmn:sourceRef>
        <bpmn:targetRef>DataInput_RegisterApplication</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Register_Database">
        <bpmn:targetRef>DataStoreReference_GrantsDatabase</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:ioSpecification id="IoSpecification_RegisterApplication">
        <bpmn:dataInput id="DataInput_RegisterApplication" name="Application form"/>
        <bpmn:inputSet id="InputSet_RegisterApplication">
          <bpmn:dataInputRefs>DataInput_RegisterApplication</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_RegisterApplication"/>
      </bpmn:ioSpecification>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CheckApplicationForm" name="Check application form">
      <bpmn:incoming>Flow_Register_CheckForm</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckForm_ReviewBudget</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInputAssociation_Form_Check">
        <bpmn:sourceRef>DataObjectReference_ApplicationForm</bpmn:sourceRef>
        <bpmn:targetRef>DataInput_CheckApplicationForm</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:ioSpecification id="IoSpecification_CheckApplicationForm">
        <bpmn:dataInput id="DataInput_CheckApplicationForm" name="Application form"/>
        <bpmn:inputSet id="InputSet_CheckApplicationForm">
          <bpmn:dataInputRefs>DataInput_CheckApplicationForm</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_CheckApplicationForm"/>
      </bpmn:ioSpecification>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviewBudgetFile" name="Review budget file">
      <bpmn:incoming>Flow_CheckForm_ReviewBudget</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewBudget_ConsultRules</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInputAssociation_Budget_Review">
        <bpmn:sourceRef>DataObjectReference_BudgetFile</bpmn:sourceRef>
        <bpmn:targetRef>DataInput_ReviewBudgetFile</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:ioSpecification id="IoSpecification_ReviewBudgetFile">
        <bpmn:dataInput id="DataInput_ReviewBudgetFile" name="Supporting budget file"/>
        <bpmn:inputSet id="InputSet_ReviewBudgetFile">
          <bpmn:dataInputRefs>DataInput_ReviewBudgetFile</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_ReviewBudgetFile"/>
      </bpmn:ioSpecification>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConsultEligibilityRules" name="Consult eligibility rules">
      <bpmn:incoming>Flow_ReviewBudget_ConsultRules</bpmn:incoming>
      <bpmn:outgoing>Flow_ConsultRules_CompleteGateway</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInputAssociation_Rules_Consult">
        <bpmn:sourceRef>DataObjectReference_EligibilityRules</bpmn:sourceRef>
        <bpmn:targetRef>DataInput_ConsultEligibilityRules</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:ioSpecification id="IoSpecification_ConsultEligibilityRules">
        <bpmn:dataInput id="DataInput_ConsultEligibilityRules" name="Eligibility rules"/>
        <bpmn:inputSet id="InputSet_ConsultEligibilityRules">
          <bpmn:dataInputRefs>DataInput_ConsultEligibilityRules</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_ConsultEligibilityRules"/>
      </bpmn:ioSpecification>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ApplicationComplete" name="Application complete?" default="Flow_Gateway_Missing">
      <bpmn:incoming>Flow_ConsultRules_CompleteGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Gateway_Missing</bpmn:outgoing>
      <bpmn:outgoing>Flow_Gateway_Complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RecordIssue" name="Record missing information issue">
      <bpmn:incoming>Flow_Gateway_Missing</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordIssue_SendRequest</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Issue_Database">
        <bpmn:targetRef>DataStoreReference_GrantsDatabase</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendCompletionRequest" name="Send request for completion">
      <bpmn:incoming>Flow_RecordIssue_SendRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_SendRequest_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_CompletionRequested" name="Completion requested">
      <bpmn:incoming>Flow_SendRequest_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_WriteEvaluationReport" name="Write evaluation report">
      <bpmn:incoming>Flow_Gateway_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_WriteReport_StoreReport</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Report">
        <bpmn:targetRef>DataOutput_EvaluationReport</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:ioSpecification id="IoSpecification_WriteEvaluationReport">
        <bpmn:dataOutput id="DataOutput_EvaluationReport" name="Evaluation report"/>
        <bpmn:inputSet id="InputSet_WriteEvaluationReport"/>
        <bpmn:outputSet id="OutputSet_WriteEvaluationReport">
          <bpmn:dataOutputRefs>DataOutput_EvaluationReport</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
    </bpmn:userTask>
    <bpmn:userTask id="Task_StoreReport" name="Store report in case repository">
      <bpmn:incoming>Flow_WriteReport_StoreReport</bpmn:incoming>
      <bpmn:outgoing>Flow_StoreReport_IssueRecommendation</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInputAssociation_Report_Store">
        <bpmn:sourceRef>DataObjectReference_EvaluationReport</bpmn:sourceRef>
        <bpmn:targetRef>DataInput_StoreReport</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Report_Repository">
        <bpmn:targetRef>DataStoreReference_CaseRepository</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:ioSpecification id="IoSpecification_StoreReport">
        <bpmn:dataInput id="DataInput_StoreReport" name="Evaluation report"/>
        <bpmn:inputSet id="InputSet_StoreReport">
          <bpmn:dataInputRefs>DataInput_StoreReport</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_StoreReport"/>
      </bpmn:ioSpecification>
    </bpmn:userTask>
    <bpmn:userTask id="Task_IssueRecommendation" name="Issue recommendation for decision">
      <bpmn:incoming>Flow_StoreReport_IssueRecommendation</bpmn:incoming>
      <bpmn:outgoing>Flow_IssueRecommendation_End</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DataInputAssociation_Report_Recommendation">
        <bpmn:sourceRef>DataObjectReference_EvaluationReport</bpmn:sourceRef>
        <bpmn:targetRef>DataInput_IssueRecommendation</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:ioSpecification id="IoSpecification_IssueRecommendation">
        <bpmn:dataInput id="DataInput_IssueRecommendation" name="Evaluation report"/>
        <bpmn:inputSet id="InputSet_IssueRecommendation">
          <bpmn:dataInputRefs>DataInput_IssueRecommendation</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_IssueRecommendation"/>
      </bpmn:ioSpecification>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_RecommendationIssued" name="Recommendation issued">
      <bpmn:incoming>Flow_IssueRecommendation_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Register" sourceRef="StartEvent_ApplicationReceived" targetRef="Task_RegisterApplication"/>
    <bpmn:sequenceFlow id="Flow_Register_CheckForm" sourceRef="Task_RegisterApplication" targetRef="Task_CheckApplicationForm"/>
    <bpmn:sequenceFlow id="Flow_CheckForm_ReviewBudget" sourceRef="Task_CheckApplicationForm" targetRef="Task_ReviewBudgetFile"/>
    <bpmn:sequenceFlow id="Flow_ReviewBudget_ConsultRules" sourceRef="Task_ReviewBudgetFile" targetRef="Task_ConsultEligibilityRules"/>
    <bpmn:sequenceFlow id="Flow_ConsultRules_CompleteGateway" sourceRef="Task_ConsultEligibilityRules" targetRef="Gateway_ApplicationComplete"/>
    <bpmn:sequenceFlow id="Flow_Gateway_Missing" name="No - information missing" sourceRef="Gateway_ApplicationComplete" targetRef="Task_RecordIssue"/>
    <bpmn:sequenceFlow id="Flow_Gateway_Complete" name="Yes - complete" sourceRef="Gateway_ApplicationComplete" targetRef="Task_WriteEvaluationReport">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">applicationComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RecordIssue_SendRequest" sourceRef="Task_RecordIssue" targetRef="Task_SendCompletionRequest"/>
    <bpmn:sequenceFlow id="Flow_SendRequest_End" sourceRef="Task_SendCompletionRequest" targetRef="EndEvent_CompletionRequested"/>
    <bpmn:sequenceFlow id="Flow_WriteReport_StoreReport" sourceRef="Task_WriteEvaluationReport" targetRef="Task_StoreReport"/>
    <bpmn:sequenceFlow id="Flow_StoreReport_IssueRecommendation" sourceRef="Task_StoreReport" targetRef="Task_IssueRecommendation"/>
    <bpmn:sequenceFlow id="Flow_IssueRecommendation_End" sourceRef="Task_IssueRecommendation" targetRef="EndEvent_RecommendationIssued"/>
    <bpmn:dataObject id="DataObject_ApplicationForm" name="Application form"/>
    <bpmn:dataObjectReference id="DataObjectReference_ApplicationForm" name="Application form" dataObjectRef="DataObject_ApplicationForm"/>
    <bpmn:dataObject id="DataObject_BudgetFile" name="Supporting budget file"/>
    <bpmn:dataObjectReference id="DataObjectReference_BudgetFile" name="Supporting budget file" dataObjectRef="DataObject_BudgetFile"/>
    <bpmn:dataObject id="DataObject_EligibilityRules" name="Eligibility rules"/>
    <bpmn:dataObjectReference id="DataObjectReference_EligibilityRules" name="Eligibility rules" dataObjectRef="DataObject_EligibilityRules"/>
    <bpmn:dataObject id="DataObject_EvaluationReport" name="Evaluation report"/>
    <bpmn:dataObjectReference id="DataObjectReference_EvaluationReport" name="Evaluation report" dataObjectRef="DataObject_EvaluationReport"/>
    <bpmn:dataStoreReference id="DataStoreReference_GrantsDatabase" name="Grants database" dataStoreRef="DataStore_GrantsDatabase"/>
    <bpmn:dataStoreReference id="DataStoreReference_CaseRepository" name="Case repository" dataStoreRef="DataStore_CaseRepository"/>
    <bpmn:textAnnotation id="TextAnnotation_IncompleteApplications">
      <bpmn:text>Incomplete applications must not be assessed for merit.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_IncompleteApplications" sourceRef="TextAnnotation_IncompleteApplications" targetRef="Gateway_ApplicationComplete" associationDirection="None"/>
  </bpmn:process>
  <bpmn:dataStore id="DataStore_GrantsDatabase" name="Grants database"/>
  <bpmn:dataStore id="DataStore_CaseRepository" name="Case repository"/>
</bpmn:definitions>
