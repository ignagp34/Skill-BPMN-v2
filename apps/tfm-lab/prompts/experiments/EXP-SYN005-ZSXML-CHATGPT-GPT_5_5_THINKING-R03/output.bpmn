<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SYN005" targetNamespace="http://example.com/bpmn/SYN005">
  <bpmn:collaboration id="Collaboration_SYN005">
    <bpmn:participant id="Participant_FinanceDepartment" name="Finance Department" processRef="Process_SYN005"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_SYN005" name="Travel reimbursement approval" isExecutable="false">
    <bpmn:laneSet id="LaneSet_SYN005">
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>StartEvent_RequestPreparation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveReturnedRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveApprovalOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRejectionMessage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReviewEnded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OutcomeMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OutcomeInformed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FinanceSpecialist" name="Finance Specialist">
        <bpmn:flowNodeRef>Task_CheckReceipts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyPolicyRules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReceiptsMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AutomaticLimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveAutomatically</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendToManager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SchedulePayment</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FinanceManager" name="Finance Manager">
        <bpmn:flowNodeRef>Gateway_ManagerDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManagerApprove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManagerReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejection</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_RequestPreparation" name="Reimbursement needed">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_SubmitRequest" name="Submit travel reimbursement request">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CheckReceipts" name="Check receipts">
      <bpmn:incoming>Flow_Submit_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Verify</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_VerifyPolicyRules" name="Verify policy rules">
      <bpmn:incoming>Flow_Check_Verify</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify_Missing</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReceiptsMissing" name="Receipts missing?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Verify_Missing</bpmn:incoming>
      <bpmn:outgoing>Flow_Missing_Return</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complete_Limit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReturnRequest" name="Return request to employee">
      <bpmn:incoming>Flow_Missing_Return</bpmn:incoming>
      <bpmn:outgoing>Flow_Return_Receive</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReceiveReturnedRequest" name="Receive returned request">
      <bpmn:incoming>Flow_Return_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveReturn_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_ReviewEnded" name="Review ended">
      <bpmn:incoming>Flow_ReceiveReturn_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_AutomaticLimit" name="Within automatic approval limit?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_Complete_Limit</bpmn:incoming>
      <bpmn:outgoing>Flow_Within_AutoApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_Exceeds_SendManager</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ApproveAutomatically" name="Approve request">
      <bpmn:incoming>Flow_Within_AutoApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_AutoApprove_ApprovalMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SendToManager" name="Send request to finance manager">
      <bpmn:incoming>Flow_Exceeds_SendManager</bpmn:incoming>
      <bpmn:outgoing>Flow_SendManager_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ManagerDecision" name="Manager decision" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_SendManager_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerDecision_Approve</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManagerDecision_Reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManagerApprove" name="Approve request">
      <bpmn:incoming>Flow_ManagerDecision_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerApprove_ApprovalMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ManagerReject" name="Reject request">
      <bpmn:incoming>Flow_ManagerDecision_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerReject_SendRejection</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ApprovalMerge" name="Approved request" gatewayDirection="Converging">
      <bpmn:incoming>Flow_AutoApprove_ApprovalMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ManagerApprove_ApprovalMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalMerge_Schedule</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SchedulePayment" name="Schedule payment">
      <bpmn:incoming>Flow_ApprovalMerge_Schedule</bpmn:incoming>
      <bpmn:outgoing>Flow_Schedule_ReceiveApproval</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReceiveApprovalOutcome" name="Receive approval outcome">
      <bpmn:incoming>Flow_Schedule_ReceiveApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveApproval_OutcomeMerge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendRejection" name="Send rejection message to employee">
      <bpmn:incoming>Flow_ManagerReject_SendRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_SendRejection_Receive</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveRejectionMessage" name="Receive rejection message">
      <bpmn:incoming>Flow_SendRejection_Receive</bpmn:incoming>
      <bpmn:outgoing>Flow_ReceiveRejection_OutcomeMerge</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_OutcomeMerge" name="Outcome informed" gatewayDirection="Converging">
      <bpmn:incoming>Flow_ReceiveApproval_OutcomeMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ReceiveRejection_OutcomeMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_OutcomeMerge_End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_OutcomeInformed" name="Employee informed of outcome">
      <bpmn:incoming>Flow_OutcomeMerge_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent_RequestPreparation" targetRef="Task_SubmitRequest"/>
    <bpmn:sequenceFlow id="Flow_Submit_Check" sourceRef="Task_SubmitRequest" targetRef="Task_CheckReceipts"/>
    <bpmn:sequenceFlow id="Flow_Check_Verify" sourceRef="Task_CheckReceipts" targetRef="Task_VerifyPolicyRules"/>
    <bpmn:sequenceFlow id="Flow_Verify_Missing" sourceRef="Task_VerifyPolicyRules" targetRef="Gateway_ReceiptsMissing"/>
    <bpmn:sequenceFlow id="Flow_Missing_Return" name="Yes" sourceRef="Gateway_ReceiptsMissing" targetRef="Task_ReturnRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">receiptsMissing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Complete_Limit" name="No" sourceRef="Gateway_ReceiptsMissing" targetRef="Gateway_AutomaticLimit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">notReceiptsMissing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Return_Receive" sourceRef="Task_ReturnRequest" targetRef="Task_ReceiveReturnedRequest"/>
    <bpmn:sequenceFlow id="Flow_ReceiveReturn_End" sourceRef="Task_ReceiveReturnedRequest" targetRef="EndEvent_ReviewEnded"/>
    <bpmn:sequenceFlow id="Flow_Within_AutoApprove" name="Yes" sourceRef="Gateway_AutomaticLimit" targetRef="Task_ApproveAutomatically">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">withinAutomaticLimit</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Exceeds_SendManager" name="No" sourceRef="Gateway_AutomaticLimit" targetRef="Task_SendToManager">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">exceedsAutomaticLimit</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_AutoApprove_ApprovalMerge" sourceRef="Task_ApproveAutomatically" targetRef="Gateway_ApprovalMerge"/>
    <bpmn:sequenceFlow id="Flow_SendManager_Decision" sourceRef="Task_SendToManager" targetRef="Gateway_ManagerDecision"/>
    <bpmn:sequenceFlow id="Flow_ManagerDecision_Approve" name="Approve" sourceRef="Gateway_ManagerDecision" targetRef="Task_ManagerApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerDecision_Reject" name="Reject" sourceRef="Gateway_ManagerDecision" targetRef="Task_ManagerReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">rejected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerApprove_ApprovalMerge" sourceRef="Task_ManagerApprove" targetRef="Gateway_ApprovalMerge"/>
    <bpmn:sequenceFlow id="Flow_ManagerReject_SendRejection" sourceRef="Task_ManagerReject" targetRef="Task_SendRejection"/>
    <bpmn:sequenceFlow id="Flow_ApprovalMerge_Schedule" sourceRef="Gateway_ApprovalMerge" targetRef="Task_SchedulePayment"/>
    <bpmn:sequenceFlow id="Flow_Schedule_ReceiveApproval" sourceRef="Task_SchedulePayment" targetRef="Task_ReceiveApprovalOutcome"/>
    <bpmn:sequenceFlow id="Flow_SendRejection_Receive" sourceRef="Task_SendRejection" targetRef="Task_ReceiveRejectionMessage"/>
    <bpmn:sequenceFlow id="Flow_ReceiveApproval_OutcomeMerge" sourceRef="Task_ReceiveApprovalOutcome" targetRef="Gateway_OutcomeMerge"/>
    <bpmn:sequenceFlow id="Flow_ReceiveRejection_OutcomeMerge" sourceRef="Task_ReceiveRejectionMessage" targetRef="Gateway_OutcomeMerge"/>
    <bpmn:sequenceFlow id="Flow_OutcomeMerge_End" sourceRef="Gateway_OutcomeMerge" targetRef="EndEvent_OutcomeInformed"/>
  </bpmn:process>
</bpmn:definitions>
