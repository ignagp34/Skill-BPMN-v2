gister claim"><bpmn:incoming>Flow_Start_Register</bpmn:incoming><bpmn:outgoing>Flow_Register_Review</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ReviewInformation" name="Review submitted information"><bpmn:incoming>Flow_Register_Review</bpmn:incoming><bpmn:outgoing>Flow_Review_Complete</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_ClaimComplete" name="Claim complete?" gatewayDirection="Diverging"><bpmn:incoming>Flow_Review_Complete</bpmn:incoming><bpmn:outgoing>Flow_Incomplete_Request</bpmn:outgoing><bpmn:outgoing>Flow_Complete_FastTrack</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_RequestMissingInformation" name="Request missing information from customer"><bpmn:incoming>Flow_Incomplete_Request</bpmn:incoming><bpmn:outgoing>Flow_Request_Close</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="EndEvent_CurrentReviewClosed" name="Current review closed"><bpmn:incoming>Flow_Request_Close</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="Gateway_FastTrack" name="Damage below fast-track threshold?" gatewayDirection="Diverging"><bpmn:incoming>Flow_Complete_FastTrack</bpmn:incoming><bpmn:outgoing>Flow_Below_Approve</bpmn:outgoing><bpmn:outgoing>Flow_Above_Forward</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_FastTrackApprove" name="Approve claim"><bpmn:incoming>Flow_Below_Approve</bpmn:incoming><bpmn:outgoing>Flow_FastApprove_NoticeMerge</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_ForwardForAssessment" name="Forward claim for detailed assessment"><bpmn:incoming>Flow_Above_Forward</bpmn:incoming><bpmn:outgoing>Flow_Forward_Assess</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_DetailedAssessment" name="Perform detailed assessment"><bpmn:incoming>Flow_Forward_Assess</bpmn:incoming><bpmn:outgoing>Flow_Assess_Decision</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_AssessmentDecision" name="Assessment decision" gatewayDirection="Diverging"><bpmn:incoming>Flow_Assess_Decision</bpmn:incoming><bpmn:outgoing>Flow_Decision_Approve</bpmn:outgoing><bpmn:outgoing>Flow_Decision_Reject</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_AssessmentApprove" name="Approve claim"><bpmn:incoming>Flow_Decision_Approve</bpmn:incoming><bpmn:outgoing>Flow_AssessApprove_NoticeMerge</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_RejectClaim" name="Reject claim"><bpmn:incoming>Flow_Decision_Reject</bpmn:incoming><bpmn:outgoing>Flow_Reject_RejectionNotice</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_NoticeMerge" name="Approved claim" gatewayDirection="Converging"><bpmn:incoming>Flow_FastApprove_NoticeMerge</bpmn:incoming><bpmn:incoming>Flow_AssessApprove_NoticeMerge</bpmn:incoming><bpmn:outgoing>Flow_NoticeMerge_Settlement</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sendTask id="Task_SendSettlementNotice" name="Send settlement notice"><bpmn:incoming>Flow_NoticeMerge_Settlement</bpmn:incoming><bpmn:outgoing>Flow_Settlement_NotificationMerge</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="Task_SendRejectionNotice" name="Send rejection notice"><bpmn:incoming>Flow_Reject_RejectionNotice</bpmn:incoming><bpmn:outgoing>Flow_Rejection_NotificationMerge</bpmn:outgoing></bpmn:sendTask><bpmn:exclusiveGateway id="Gateway_NotificationMerge" name="Customer notified" gatewayDirection="Converging"><bpmn:incoming>Flow_Settlement_NotificationMerge</bpmn:incoming><bpmn:incoming>Flow_Rejection_NotificationMerge</bpmn:incoming><bpmn:outgoing>Flow_NotificationMerge_End</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="EndEvent_CustomerNotified" name="Customer notified"><bpmn:incoming>Flow_NotificationMerge_End</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Start_Register" sourceRef="StartEvent_NewClaim" targetRef="Task_RegisterClaim" /><bpmn:sequenceFlow id="Flow_Register_Review" sourceRef="Task_RegisterClaim" targetRef="Task_ReviewInformation" /><bpmn:sequenceFlow id="Flow_Review_Complete" sourceRef="Task_ReviewIn