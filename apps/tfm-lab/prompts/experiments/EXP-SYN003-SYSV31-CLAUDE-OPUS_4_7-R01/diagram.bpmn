<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn"><bpmn:collaboration id="Collaboration_1"><bpmn:participant id="Participant_Pool_1" name="Pool_1" processRef="Process_Pool_1" /></bpmn:collaboration><bpmn:process id="Process_Pool_1" isExecutable="false"><bpmn:laneSet id="LaneSet_Pool_1"><bpmn:lane id="Lane_Pool_1" name="Pool_1"><bpmn:flowNodeRef>Event_Pool_1_start_Patient_arrives</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Pool_1_Greet_patient</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Pool_1_Confirm_appointment</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Pool_1_Update_arrival_in_system</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Pool_1_Print_visit_label</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Pool_1_Direct_patient_to_waiting_area</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_Pool_1_finish_Check_in_complete</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="Event_Pool_1_start_Patient_arrives" name="Patient arrives"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_Pool_1_Greet_patient" name="Greet patient"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_Pool_1_Confirm_appointment" name="Confirm appointment"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_Pool_1_Update_arrival_in_system" name="Update arrival in system"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_Pool_1_Print_visit_label" name="Print visit label"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Task_Pool_1_Direct_patient_to_waiting_area" name="Direct patient to waiting area"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="Event_Pool_1_finish_Check_in_complete" name="Check-in complete"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Pool_1_start_Patient_arrives" targetRef="Task_Pool_1_Greet_patient" /><bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Pool_1_Greet_patient" targetRef="Task_Pool_1_Confirm_appointment" /><bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Pool_1_Confirm_appointment" targetRef="Task_Pool_1_Update_arrival_in_system" /><bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Pool_1_Update_arrival_in_system" targetRef="Task_Pool_1_Print_visit_label" /><bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Pool_1_Print_visit_label" targetRef="Task_Pool_1_Direct_patient_to_waiting_area" /><bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Pool_1_Direct_patient_to_waiting_area" targetRef="Event_Pool_1_finish_Check_in_complete" /></bpmn:process><bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_1"><bpmndi:BPMNPlane id="BPMNPlane_Collaboration_1" bpmnElement="Collaboration_1"><bpmndi:BPMNShape id="Participant_Pool_1_di" bpmnElement="Participant_Pool_1" isHorizontal="true"><dc:Bounds x="-3" y="0" width="1026" height="196" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_Pool_1_di" bpmnElement="Lane_Pool_1" isHorizontal="true"><dc:Bounds x="27" y="20" width="996" height="156" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Event_Pool_1_start_Patient_arrives_di" bpmnElement="Event_Pool_1_start_Patient_arrives"><dc:Bounds x="57" y="80" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Pool_1_Greet_patient_di" bpmnElement="Task_Pool_1_Greet_patient"><dc:Bounds x="175" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Pool_1_Confirm_appointment_di" bpmnElement="Task_Pool_1_Confirm_appointment"><dc:Bounds x="325" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Pool_1_Update_arrival_in_system_di" bpmnElement="Task_Pool_1_Update_arrival_in_system"><dc:Bounds x="475" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Pool_1_Print_visit_label_di" bpmnElement="Task_Pool_1_Print_visit_label"><dc:Bounds x="625" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_Pool_1_Direct_patient_to_waiting_area_di" bpmnElement="Task_Pool_1_Direct_patient_to_waiting_area"><dc:Bounds x="775" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Event_Pool_1_finish_Check_in_complete_di" bpmnElement="Event_Pool_1_finish_Check_in_complete"><dc:Bounds x="957" y="80" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="93" y="98" /><di:waypoint x="175" y="98" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="275" y="98" /><di:waypoint x="325" y="98" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="425" y="98" /><di:waypoint x="475" y="98" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="575" y="98" /><di:waypoint x="625" y="98" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="725" y="98" /><di:waypoint x="775" y="98" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="875" y="98" /><di:waypoint x="957" y="98" /></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>