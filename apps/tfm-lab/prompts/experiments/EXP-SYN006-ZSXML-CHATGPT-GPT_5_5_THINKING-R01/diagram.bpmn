<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SYN006" targetNamespace="http://example.com/bpmn/SYN006"><bpmn:collaboration id="Collaboration_SYN006"><bpmn:participant id="Participant_RetailBank" name="Retail Bank" processRef="Process_SYN006" /></bpmn:collaboration><bpmn:process id="Process_SYN006" name="Bank card application outcome" isExecutable="false"><bpmn:laneSet id="LaneSet_RetailBank"><bpmn:lane id="Lane_BankingOfficer" name="Banking Officer"><bpmn:flowNodeRef>StartEvent_ApplicationReceived</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReceiveApplication</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CheckInformation</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_InformationComplete</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RequestMissingInformation</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_ApplicationStopped</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_PerformCreditCheck</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_CreditResult</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SendForManualReview</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ApprovalMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CreateCardAccount</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_OrderCard</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SendApprovalMessage</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_RejectionMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SendRejectionMessage</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_NotificationMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_CustomerNotified</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Supervisor" name="Supervisor"><bpmn:flowNodeRef>Task_ManualReview</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ManualReviewDecision</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="StartEvent_ApplicationReceived" name="Application received"><bpmn:outgoing>Flow_Start_Receive</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_ReceiveApplication" name="Receive credit card application"><bpmn:incoming>Flow_Start_Receive</bpmn:incoming><bpmn:outgoing>Flow_Receive_Check</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_CheckInformation" name="Check provided information"><bpmn:incoming>Flow_Receive_Check</bpmn:incoming><bpmn:outgoing>Flow_Check_CompleteGateway</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_InformationComplete" name="Mandatory information complete?" default="Flow_InfoMissing"><bpmn:incoming>Flow_Check_CompleteGateway</bpmn:incoming><bpmn:outgoing>Flow_InfoMissing</bpmn:outgoing><bpmn:outgoing>Flow_InfoComplete</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sendTask id="Task_RequestMissingInformation" name="Ask customer to submit missing information"><bpmn:incoming>Flow_InfoMissing</bpmn:incoming><bpmn:outgoing>Flow_RequestMissing_Stop</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="EndEvent_ApplicationStopped" name="Application stopped for now"><bpmn:incoming>Flow_RequestMissing_Stop</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_PerformCreditCheck" name="Perform credit check"><bpmn:incoming>Flow_InfoComplete</bpmn:incoming><bpmn:outgoing>Flow_CreditCheck_Result</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_CreditResult" name="Credit result?" default="Flow_CreditDeclined"><bpmn:incoming>Flow_CreditCheck_Result</bpmn:incoming><bpmn:outgoing>Flow_CreditApproved</bpmn:outgoing><bpmn:outgoing>Flow_CreditBorderline</bpmn:outgoing><bpmn:outgoing>Flow_CreditDeclined</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sendTask id="Task_SendForManualReview" name="Send application to supervisor for manual review"><bpmn:incoming>Flow_CreditBorderline</bpmn:incoming><bpmn:outgoing>Flow_SendReview_ManualReview</bpmn:outgoing></bpmn:sendTask><bpmn:userTask id="Task_ManualReview" name="Manually review application"><bpmn:incoming>Flow_SendReview_ManualReview</bpmn:incoming><bpmn:outgoing>Flow_ManualReview_Decision</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_ManualReviewDecision" name="Manual review decision?" default="Flow_ReviewRejected"><bpmn:incoming>Flow_ManualReview_Decision</bpmn:incoming><bpmn:outgoing>Flow_ReviewApproved</bpmn:outgoing><bpmn:outgoing>Flow_ReviewRejected</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Gateway_ApprovalMerge" name="Approved application"><bpmn:incoming>Flow_CreditApproved</bpmn:incoming><bpmn:incoming>Flow_ReviewApproved</bpmn:incoming><bpmn:outgoing>Flow_ApprovalMerge_CreateAccount</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_CreateCardAccount" name="Create card account"><bpmn:incoming>Flow_ApprovalMerge_CreateAccount</bpmn:incoming><bpmn:outgoing>Flow_CreateAccount_OrderCard</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_OrderCard" name="Order card"><bpmn:incoming>Flow_CreateAccount_OrderCard</bpmn:incoming><bpmn:outgoing>Flow_OrderCard_ApprovalMessage</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="Task_SendApprovalMessage" name="Send approval message to customer"><bpmn:incoming>Flow_OrderCard_ApprovalMessage</bpmn:incoming><bpmn:outgoing>Flow_ApprovalMessage_NotificationMerge</bpmn:outgoing></bpmn:sendTask><bpmn:exclusiveGateway id="Gateway_RejectionMerge" name="Rejected application"><bpmn:incoming>Flow_CreditDeclined</bpmn:incoming><bpmn:incoming>Flow_ReviewRejected</bpmn:incoming><bpmn:outgoing>Flow_RejectionMerge_RejectionMessage</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sendTask id="Task_SendRejectionMessage" name="Send rejection message to customer"><bpmn:incoming>Flow_RejectionMerge_RejectionMessage</bpmn:incoming><bpmn:outgoing>Flow_RejectionMessage_NotificationMerge</bpmn:outgoing></bpmn:sendTask><bpmn:exclusiveGateway id="Gateway_NotificationMerge" name="Customer notified"><bpmn:incoming>Flow_ApprovalMessage_NotificationMerge</bpmn:incoming><bpmn:incoming>Flow_RejectionMessage_NotificationMerge</bpmn:incoming><bpmn:outgoing>Flow_NotificationMerge_End</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="EndEvent_CustomerNotified" name="Customer notified"><bpmn:incoming>Flow_NotificationMerge_End</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Start_Receive" sourceRef="StartEvent_ApplicationReceived" targetRef="Task_ReceiveApplication" /><bpmn:sequenceFlow id="Flow_Receive_Check" sourceRef="Task_ReceiveApplication" targetRef="Task_CheckInformation" /><bpmn:sequenceFlow id="Flow_Check_CompleteGateway" sourceRef="Task_CheckInformation" targetRef="Gateway_InformationComplete" /><bpmn:sequenceFlow id="Flow_InfoMissing" name="Missing" sourceRef="Gateway_InformationComplete" targetRef="Task_RequestMissingInformation" /><bpmn:sequenceFlow id="Flow_InfoComplete" name="Complete" sourceRef="Gateway_InformationComplete" targetRef="Task_PerformCreditCheck"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">informationComplete = true</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_RequestMissing_Stop" sourceRef="Task_RequestMissingInformation" targetRef="EndEvent_ApplicationStopped" /><bpmn:sequenceFlow id="Flow_CreditCheck_Result" sourceRef="Task_PerformCreditCheck" targetRef="Gateway_CreditResult" /><bpmn:sequenceFlow id="Flow_CreditApproved" name="Approved" sourceRef="Gateway_CreditResult" targetRef="Gateway_ApprovalMerge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">creditResult = "approved"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_CreditBorderline" name="Borderline" sourceRef="Gateway_CreditResult" targetRef="Task_SendForManualReview"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">creditResult = "borderline"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_CreditDeclined" name="Declined" sourceRef="Gateway_CreditResult" targetRef="Gateway_RejectionMerge" /><bpmn:sequenceFlow id="Flow_SendReview_ManualReview" sourceRef="Task_SendForManualReview" targetRef="Task_ManualReview" /><bpmn:sequenceFlow id="Flow_ManualReview_Decision" sourceRef="Task_ManualReview" targetRef="Gateway_ManualReviewDecision" /><bpmn:sequenceFlow id="Flow_ReviewApproved" name="Approved" sourceRef="Gateway_ManualReviewDecision" targetRef="Gateway_ApprovalMerge"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">manualDecision = "approved"</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_ReviewRejected" name="Rejected" sourceRef="Gateway_ManualReviewDecision" targetRef="Gateway_RejectionMerge" /><bpmn:sequenceFlow id="Flow_ApprovalMerge_CreateAccount" sourceRef="Gateway_ApprovalMerge" targetRef="Task_CreateCardAccount" /><bpmn:sequenceFlow id="Flow_CreateAccount_OrderCard" sourceRef="Task_CreateCardAccount" targetRef="Task_OrderCard" /><bpmn:sequenceFlow id="Flow_OrderCard_ApprovalMessage" sourceRef="Task_OrderCard" targetRef="Task_SendApprovalMessage" /><bpmn:sequenceFlow id="Flow_ApprovalMessage_NotificationMerge" sourceRef="Task_SendApprovalMessage" targetRef="Gateway_NotificationMerge" /><bpmn:sequenceFlow id="Flow_RejectionMerge_RejectionMessage" sourceRef="Gateway_RejectionMerge" targetRef="Task_SendRejectionMessage" /><bpmn:sequenceFlow id="Flow_RejectionMessage_NotificationMerge" sourceRef="Task_SendRejectionMessage" targetRef="Gateway_NotificationMerge" /><bpmn:sequenceFlow id="Flow_NotificationMerge_End" sourceRef="Gateway_NotificationMerge" targetRef="EndEvent_CustomerNotified" /></bpmn:process><bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_SYN006"><bpmndi:BPMNPlane id="BPMNPlane_Collaboration_SYN006" bpmnElement="Collaboration_SYN006"><bpmndi:BPMNShape id="Participant_RetailBank_di" bpmnElement="Participant_RetailBank" isHorizontal="true"><dc:Bounds x="-3" y="0" width="1776" height="772" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_BankingOfficer_di" bpmnElement="Lane_BankingOfficer" isHorizontal="true"><dc:Bounds x="27" y="20" width="1746" hei