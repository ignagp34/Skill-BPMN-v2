going>Flow_3</bpmn:outgoing></bpmn:task><bpmn:intermediateCatchEvent id="Event_Builder_receive_Parts" name="Parts"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent><bpmn:task id="Task_Builder_Build" name="Build"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task><bpmn:task id="Task_Builder_Check_stock" name="Check stock"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task><bpmn:task id="Task_Builder_Finish_building" name="Finish building"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:task><bpmn:endEvent id="Event_Builder_finish" name="finish"><bpmn:incoming>Flow_11</bpmn:incoming></bpmn:endEvent><bpmn:task id="Task_Builder_Reorder_cheapest_parts" name="Reorder cheapest parts"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task><bpmn:task id="Task_Builder_Reorder_fastest_parts" name="Reorder fastest parts"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:task><bpmn:sendTask id="Task_Builder_Complaint_email_to_friends" name="Complaint email to friends"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:sendTask><bpmn:exclusiveGateway id="Gateway_Builder_Check_stock" name="What is the stock level?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Merge_Builder_Build"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:dataObjectReference id="DataObject_object_Builder_Order_List_Task_Builder_Create_order_list_Tas" name="Order List" /><