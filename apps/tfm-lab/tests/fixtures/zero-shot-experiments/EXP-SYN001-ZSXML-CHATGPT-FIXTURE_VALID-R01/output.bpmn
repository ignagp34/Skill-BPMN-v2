<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             id="Definitions_Valid" targetNamespace="http://example.com/bpmn">
  <process id="Process_Valid" isExecutable="false">
    <startEvent id="Start_Valid" name="Start"/>
    <task id="Task_Valid" name="Work"/>
    <endEvent id="End_Valid" name="End"/>
    <sequenceFlow id="Flow_1" sourceRef="Start_Valid" targetRef="Task_Valid"/>
    <sequenceFlow id="Flow_2" sourceRef="Task_Valid" targetRef="End_Valid"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_Valid">
    <bpmndi:BPMNPlane id="Plane_Valid" bpmnElement="Process_Valid">
      <bpmndi:BPMNShape id="Start_Valid_di" bpmnElement="Start_Valid">
        <dc:Bounds x="100" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Valid_di" bpmnElement="Task_Valid">
        <dc:Bounds x="200" y="78" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Valid_di" bpmnElement="End_Valid">
        <dc:Bounds x="360" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
