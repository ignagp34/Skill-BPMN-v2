<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_SYN006"
                  targetNamespace="http://example.com/bpmn/SYN006">
  <bpmn:collaboration id="Collaboration_SYN006">
    <bpmn:participant id="Participant_RetailBank" name="Retail Bank" processRef="Process_SYN006"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_SYN006" name="Bank card application outcome" isExecutable="false">
    <bpmn:laneSet id="LaneSet_RetailBank">
      <bpmn:lane id="Lane_BankingOfficer" name="Banking Officer">
        <bpmn:flowNodeRef>StartEvent_ApplicationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InformationComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestMissingInformation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ApplicationStopped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformCreditCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CreditResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendForManualReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateCardAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendApprovalMessage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RejectionMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejectionMessage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotificationMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CustomerNotified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>Task_ManualReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ManualReviewDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_ApplicationReceived" name="Credit card application received"/>
    <bpmn:userTask id="Task_ReceiveApplication" name="Receive application"/>
    <bpmn:userTask id="Task_CheckInformation" name="Check provided information"/>
    <bpmn:exclusiveGateway id="Gateway_InformationComplete" name="Mandatory information complete?"/>
    <bpmn:sendTask id="Task_RequestMissingInformation" name="Ask customer to submit missing information"/>
    <bpmn:endEvent id="EndEvent_ApplicationStopped" name="Application stopped pending information"/>
    <bpmn:userTask id="Task_PerformCreditCheck" name="Perform credit check"/>
    <bpmn:exclusiveGateway id="Gateway_CreditResult" name="Credit result"/>
    <bpmn:userTask id="Task_SendForManualReview" name="Send application to supervisor"/>
    <bpmn:userTask id="Task_ManualReview" name="Manually review application"/>
    <bpmn:exclusiveGateway id="Gateway_ManualReviewDecision" name="Manual review decision"/>
    <bpmn:exclusiveGateway id="Gateway_ApprovalMerge" name="Merge approved applications" gatewayDirection="Converging"/>
    <bpmn:userTask id="Task_CreateCardAccount" name="Create card account"/>
    <bpmn:userTask id="Task_OrderCard" name="Order card"/>
    <bpmn:sendTask id="Task_SendApprovalMessage" name="Send approval message to customer"/>
    <bpmn:exclusiveGateway id="Gateway_RejectionMerge" name="Merge rejected applications" gatewayDirection="Converging"/>
    <bpmn:sendTask id="Task_SendRejectionMessage" name="Send rejection message to customer"/>
    <bpmn:exclusiveGateway id="Gateway_NotificationMerge" name="Merge notification outcomes" gatewayDirection="Converging"/>
    <bpmn:endEvent id="EndEvent_CustomerNotified" name="Customer notified"/>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_ApplicationReceived" targetRef="Task_ReceiveApplication"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ReceiveApplication" targetRef="Task_CheckInformation"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_CheckInformation" targetRef="Gateway_InformationComplete"/>
    <bpmn:sequenceFlow id="Flow_04_Missing" name="Missing" sourceRef="Gateway_InformationComplete" targetRef="Task_RequestMissingInformation"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_RequestMissingInformation" targetRef="EndEvent_ApplicationStopped"/>
    <bpmn:sequenceFlow id="Flow_06_Complete" name="Complete" sourceRef="Gateway_InformationComplete" targetRef="Task_PerformCreditCheck"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_PerformCreditCheck" targetRef="Gateway_CreditResult"/>
    <bpmn:sequenceFlow id="Flow_08_Approved" name="Approved" sourceRef="Gateway_CreditResult" targetRef="Gateway_ApprovalMerge"/>
    <bpmn:sequenceFlow id="Flow_09_Borderline" name="Borderline" sourceRef="Gateway_CreditResult" targetRef="Task_SendForManualReview"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_SendForManualReview" targetRef="Task_ManualReview"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_ManualReview" targetRef="Gateway_ManualReviewDecision"/>
    <bpmn:sequenceFlow id="Flow_12_ManualApproved" name="Approved" sourceRef="Gateway_ManualReviewDecision" targetRef="Gateway_ApprovalMerge"/>
    <bpmn:sequenceFlow id="Flow_13_Declined" name="Declined" sourceRef="Gateway_CreditResult" targetRef="Gateway_RejectionMerge"/>
    <bpmn:sequenceFlow id="Flow_14_ManualRejected" name="Rejected" sourceRef="Gateway_ManualReviewDecision" targetRef="Gateway_RejectionMerge"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_ApprovalMerge" targetRef="Task_CreateCardAccount"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_CreateCardAccount" targetRef="Task_OrderCard"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_OrderCard" targetRef="Task_SendApprovalMessage"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_SendApprovalMessage" targetRef="Gateway_NotificationMerge"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_RejectionMerge" targetRef="Task_SendRejectionMessage"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_SendRejectionMessage" targetRef="Gateway_NotificationMerge"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_NotificationMerge" targetRef="EndEvent_CustomerNotified"/>
  </bpmn:process>
</bpmn:definitions>
