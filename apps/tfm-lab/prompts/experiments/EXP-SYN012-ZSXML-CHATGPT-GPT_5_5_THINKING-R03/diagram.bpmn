loseDispute" name="Close dispute"><bpmn:incoming>Flow_Explanation_Close</bpmn:incoming><bpmn:outgoing>Flow_Close_EndCorrect</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="EndEvent_PatientInformedCorrect" name="Patient informed and dispute closed"><bpmn:incoming>Flow_Close_EndCorrect</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_PrepareAdjustment" name="Prepare adjustment form"><bpmn:incoming>Flow_Incorrect_Adjustment</bpmn:incoming><bpmn:outgoing>Flow_Adjustment_Update</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOutputAssociation_AdjustmentForm"><bpmn:targetRef>DataObjectRef_AdjustmentForm</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask><bpmn:userTask id="Task_UpdateBillingSystem" name="Update billing system"><bpmn:incoming>Flow_Adjustment_Update</bpmn:incoming><bpmn:outgoing>Flow_Update_Issue</bpmn:outgoing><bpmn:dataInputAssociation id="DataInputAssociation_UpdateAdjustmentForm"><bpmn:sourceRef>DataObjectRef_AdjustmentForm</bpmn:sourceRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="DataOutputAssociation_UpdateBillingSystem"><bpmn:targetRef>DataStoreRef_BillingSystem</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask><bpmn:userTask id="Task_IssueCorrectedInvoice" name="Issue corrected invoice"><bpmn:incoming>Flow_Update_Issue</bpmn:incoming><bpmn:outgoing>Flow_Issue_SendCorrected</bpmn:outgoing><bpmn:dataInputAssociation id="DataInputAssociation_IssueBillingSystem"><bpmn:sourceRef>DataStoreRef_BillingSystem</bpmn:sourceRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="DataOutputAssociation_CorrectedInvoice"><bpmn:targetRef>DataObjectRef_CorrectedInvoice</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask><bpmn:sendTask id="Task_SendCorrectedInvoice" name="Send corrected invoice to patient"><bpmn:incoming>Flow_Issue_SendCorrected</bpmn:incoming><bpmn:outgoing>Flow_SendCorrected_EndAdjusted</bpmn:outgoing><bpmn:dataInputAssociation id="DataInputAssociation_SendCorrectedInvoice"><bpmn:sou