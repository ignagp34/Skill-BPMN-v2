<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SYN001" targetNamespace="http://example.com/bpmn/SYN001"><bpmn:collaboration id="Collaboration_SYN001"><bpmn:participant id="Participant_RegistrarOffice" name="University Registrar Office" processRef="Process_SYN001" /></bpmn:collaboration><bpmn:process id="Process_SYN001" name="University Enrollment Certificate" isExecutable="false"><bpmn:laneSet id="LaneSet_SYN001"><bpmn:lane id="Lane_RegistrarClerk" name="Registrar Clerk"><bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReceiveRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_LookUpRecord</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_GenerateCertificate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CheckCompleteness</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SendCertificate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CloseRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_RequestClosed</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="StartEvent_RequestReceived" name="Certificate requested"><bpmn:outgoing>Flow_Start_Receive</bpmn:outgoing></bpmn:startEvent><bpmn:receiveTask id="Task_ReceiveRequest" name="Receive enrollment certificate request"><bpmn:incoming>Flow_Start_Receive</bpmn:incoming><bpmn:outgoing>Flow_Receive_LookUp</bpmn:outgoing></bpmn:receiveTask><bpmn:userTask id="Task_LookUpRecord" name="Look up student record"><bpmn:incoming>Flow_Receive_LookUp</bpmn:incoming><bpmn:outgoing>Flow_LookUp_Generate</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_GenerateCertificate" name="Generate enrollment certificate"><bpmn:incoming>Flow_LookUp_Generate</bpmn:incoming><bpmn:outgoing>Flow_Generate_Check</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_CheckCompleteness" name="Check document for completeness"><bpmn:incoming>Flow_Generate_Check</bpmn:incoming><bpmn:outgoing>Flow_Check_Send</bpmn:outgoing></bpmn:userTask><bpmn:sendTask id="Task_SendCertificate" name="Send certificate to student by email"><bpmn:incoming>Flow_Check_Send</bpmn:incoming><bpmn:outgoing>Flow_Send_Close</bpmn:outgoing></bpmn:sendTask><bpmn:userTask id="Task_CloseRequest" name="Close request"><bpmn:incoming>Flow_Send_Close</bpmn:incoming><bpmn:outgoing>Flow_Close_End</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="EndEvent_RequestClosed" name="Request closed"><bpmn:incoming>Flow_Close_End</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_Start_Receive" sourceRef="StartEvent_RequestReceived" targetRef="Task_ReceiveRequest" /><bpmn:sequenceFlow id="Flow_Receive_LookUp" sourceRef="Task_ReceiveRequest" targetRef="Task_LookUpRecord" /><bpmn:sequenceFlow id="Flow_LookUp_Generate" sourceRef="Task_LookUpRecord" targetRef="Task_GenerateCertificate" /><bpmn:sequenceFlow id="Flow_Generate_Check" sourceRef="Task_GenerateCertificate" targetRef="Task_CheckCompleteness" /><bpmn:sequenceFlow id="Flow_Check_Send" sourceRef="Task_CheckCompleteness" targetRef="Task_SendCertificate" /><bpmn:sequenceFlow id="Flow_Send_Close" sourceRef="Task_SendCertificate" targetRef="Task_CloseRequest" /><bpmn:sequenceFlow id="Flow_Close_End" sourceRef="Task_CloseRequest" targetRef="EndEvent_RequestClosed" /></bpmn:process><bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_SYN001"><bpmndi:BPMNPlane id="BPMNPlane_Collaboration_SYN001" bpmnElement="Collaboration_SYN001"><bpmndi:BPMNShape id="Participant_RegistrarOffice_di" bpmnElement="Participant_RegistrarOffice" isHorizontal="true"><dc:Bounds x="-3" y="0" width="1176" height="196" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Lane_RegistrarClerk_di" bpmnElement="Lane_RegistrarClerk" isHorizontal="true"><dc:Bounds x="27" y="20" width="1146" height="156" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="StartEvent_RequestReceived_di" bpmnElement="StartEvent_RequestReceived"><dc:Bounds x="57" y="80" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_ReceiveRequest_di" bpmnElement="Task_ReceiveRequest"><dc:Bounds x="175" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_LookUpRecord_di" bpmnElement="Task_LookUpRecord"><dc:Bounds x="325" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_GenerateCertificate_di" bpmnElement="Task_GenerateCertificate"><dc:Bounds x="475" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_CheckCompleteness_di" bpmnElement="Task_CheckCompleteness"><dc:Bounds x="625" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_SendCertificate_di" bpmnElement="Task_SendCertificate"><dc:Bounds x="775" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="Task_CloseRequest_di" bpmnElement="Task_CloseRequest"><dc:Bounds x="925" y="58" width="100" height="80" /></bpmndi:BPMNShape><bpmndi:BPMNShape id="EndEvent_RequestClosed_di" bpmnElement="EndEvent_RequestClosed"><dc:Bounds x="1107" y="80" width="36" height="36" /></bpmndi:BPMNShape><bpmndi:BPMNEdge id="Flow_Start_Receive_di" bpmnElement="Flow_Start_Receive"><di:waypoint x="93" y="98" /><di:waypoint x="175" y="98" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Receive_LookUp_di" bpmnElement="Flow_Receive_LookUp"><di:waypoint x="275" y="98" /><di:waypoint x="325" y="98" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_LookUp_Generate_di" bpmnElement="Flow_LookUp_Generate"><di:waypoint x="425" y="98" /><di:waypoint x="475" y="98" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Generate_Check_di" bpmnElement="Flow_Generate_Check"><di:waypoint x="575" y="98" /><di:waypoint x="625" y="98" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Check_Send_di" bpmnElement="Flow_Check_Send"><di:waypoint x="725" y="98" /><di:waypoint x="775" y="98" /></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Flow_Send_Close_di" bpmnElement=