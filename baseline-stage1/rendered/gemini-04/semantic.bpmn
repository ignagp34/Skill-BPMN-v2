w id="Flow_16" sourceRef="StartEvent_implicit_Task_Builder_Query_web_shops" targetRef="Task_Builder_Query_web_shops" /><bpmn:textAnnotation id="TextAnnotation_Builder_1"><bpmn:text>Query for availability, price, and delivery time</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TextAnnotation_Builder_2"><bpmn:text>Always use cheapest parts</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TextAnnotation_Builder_3"><bpmn:text>If not enough parts, split across multiple shops</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="TextAnnotation_Builder_4"><bpmn:text>Parts arrive in random batches +/- 2 days</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_Builder_1" sourceRef="Task_Builder_Create_order_list" targetRef="TextAnnotation_Builder_1" /><bpmn:association id="Association_Builder_2" sourceRef="Task_Builder_Order_parts" targetRef="TextAnnotation_Builder_2" /><bpmn:association id="Association_Builder_3" sourceRef="Task_Builder_Order_parts" targetRef="TextAnnotation_Builder_3" /><bpmn:association id="Association_Builder_4" sourceRef="Event_Builder_receive_Parts" targetRef="TextAnnotation_Builder_4" /><bpmn:association id="Association_Builder_5" sourceRef="Task_Builder_Create_order_list" targetRef="DataObject_object_Builder_Order_List_Task_Builder_Create_order_list_Tas" /><bpmn:association id="Association_Builder_6" sourceRef="DataObject_object_Builder_Order_List_Task_Builder_Create_order_list_Tas" targetRef="Task_Builder_Order_parts" /><bpmn:association id="Association_Builder_7" sourceRef="Event_Builder_receive_Parts" targetRef="DataObject_object_Builder_Parts_Event_Builder_receive_Parts_Task_Builde" /><bpmn:association id="Association_Builder_8" sourceRef="DataObject_object_Builder_Parts_Event_Builder_receive_Parts_Task_Builde" targetRef="Task_Builder_Build" /></bpmn:process></bpmn:definitions>
