<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_SYN010"
                  targetNamespace="http://example.com/bpmn/SYN010">
  <bpmn:message id="Message_PurchaseOrder" name="Purchase order"/>
  <bpmn:message id="Message_OrderConfirmation" name="Order confirmation"/>
  <bpmn:message id="Message_RevisedOffer" name="Revised offer"/>
  <bpmn:message id="Message_Acceptance" name="Acceptance"/>
  <bpmn:message id="Message_Rejection" name="Rejection"/>
  <bpmn:message id="Message_FinalConfirmation" name="Final confirmation"/>

  <bpmn:collaboration id="Collaboration_SYN010">
    <bpmn:participant id="Participant_Buyer" name="Buyer" processRef="Process_Buyer"/>
    <bpmn:participant id="Participant_Supplier" name="Supplier" processRef="Process_Supplier"/>
    <bpmn:messageFlow id="MessageFlow_PurchaseOrder" name="Purchase order" sourceRef="Task_SendPurchaseOrder" targetRef="Task_ReceivePurchaseOrder"/>
    <bpmn:messageFlow id="MessageFlow_OrderConfirmation" name="Order confirmation" sourceRef="Task_SendOrderConfirmation" targetRef="Task_ReceiveOrderConfirmation"/>
    <bpmn:messageFlow id="MessageFlow_RevisedOffer" name="Revised offer" sourceRef="Task_SendRevisedOffer" targetRef="Task_ReceiveRevisedOffer"/>
    <bpmn:messageFlow id="MessageFlow_Acceptance" name="Acceptance" sourceRef="Task_SendAcceptance" targetRef="Task_ReceiveAcceptance"/>
    <bpmn:messageFlow id="MessageFlow_Rejection" name="Rejection" sourceRef="Task_SendRejection" targetRef="Task_ReceiveRejection"/>
    <bpmn:messageFlow id="MessageFlow_FinalConfirmation" name="Final confirmation" sourceRef="Task_SendFinalConfirmation" targetRef="Task_ReceiveFinalConfirmation"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Buyer" name="Buyer purchase confirmation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Buyer">
      <bpmn:lane id="Lane_Buyer" name="Buyer">
        <bpmn:flowNodeRef>StartEvent_Buyer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPurchaseOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BuyerSupplierResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveOrderConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRevisedOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewRevisedOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BuyerDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveFinalConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_BuyerConfirmedDirect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_BuyerConfirmedRevised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_BuyerRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Buyer" name="Purchase required">
      <bpmn:outgoing>Flow_Buyer_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_SendPurchaseOrder" name="Send purchase order" messageRef="Message_PurchaseOrder">
      <bpmn:incoming>Flow_Buyer_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_BuyerSupplierResponse" name="Supplier response">
      <bpmn:incoming>Flow_Buyer_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_Buyer_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="Task_ReceiveOrderConfirmation" name="Receive order confirmation" messageRef="Message_OrderConfirmation">
      <bpmn:incoming>Flow_Buyer_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer_5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndEvent_BuyerConfirmedDirect" name="Order confirmed">
      <bpmn:incoming>Flow_Buyer_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Task_ReceiveRevisedOffer" name="Receive revised offer" messageRef="Message_RevisedOffer">
      <bpmn:incoming>Flow_Buyer_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer_6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_ReviewRevisedOffer" name="Review revised offer">
      <bpmn:incoming>Flow_Buyer_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_BuyerDecision" name="Accept revised offer?">
      <bpmn:incoming>Flow_Buyer_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_Buyer_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendAcceptance" name="Send acceptance" messageRef="Message_Acceptance">
      <bpmn:incoming>Flow_Buyer_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Task_ReceiveFinalConfirmation" name="Receive final confirmation" messageRef="Message_FinalConfirmation">
      <bpmn:incoming>Flow_Buyer_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer_11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndEvent_BuyerConfirmedRevised" name="Order confirmed">
      <bpmn:incoming>Flow_Buyer_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_SendRejection" name="Send rejection" messageRef="Message_Rejection">
      <bpmn:incoming>Flow_Buyer_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Buyer_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_BuyerRejected" name="Order rejected">
      <bpmn:incoming>Flow_Buyer_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Buyer_1" sourceRef="StartEvent_Buyer" targetRef="Task_SendPurchaseOrder"/>
    <bpmn:sequenceFlow id="Flow_Buyer_2" sourceRef="Task_SendPurchaseOrder" targetRef="Gateway_BuyerSupplierResponse"/>
    <bpmn:sequenceFlow id="Flow_Buyer_3" name="Order confirmed" sourceRef="Gateway_BuyerSupplierResponse" targetRef="Task_ReceiveOrderConfirmation"/>
    <bpmn:sequenceFlow id="Flow_Buyer_4" name="Revised offer received" sourceRef="Gateway_BuyerSupplierResponse" targetRef="Task_ReceiveRevisedOffer"/>
    <bpmn:sequenceFlow id="Flow_Buyer_5" sourceRef="Task_ReceiveOrderConfirmation" targetRef="EndEvent_BuyerConfirmedDirect"/>
    <bpmn:sequenceFlow id="Flow_Buyer_6" sourceRef="Task_ReceiveRevisedOffer" targetRef="Task_ReviewRevisedOffer"/>
    <bpmn:sequenceFlow id="Flow_Buyer_7" sourceRef="Task_ReviewRevisedOffer" targetRef="Gateway_BuyerDecision"/>
    <bpmn:sequenceFlow id="Flow_Buyer_8" name="Accept" sourceRef="Gateway_BuyerDecision" targetRef="Task_SendAcceptance"/>
    <bpmn:sequenceFlow id="Flow_Buyer_9" name="Reject" sourceRef="Gateway_BuyerDecision" targetRef="Task_SendRejection"/>
    <bpmn:sequenceFlow id="Flow_Buyer_10" sourceRef="Task_SendAcceptance" targetRef="Task_ReceiveFinalConfirmation"/>
    <bpmn:sequenceFlow id="Flow_Buyer_11" sourceRef="Task_ReceiveFinalConfirmation" targetRef="EndEvent_BuyerConfirmedRevised"/>
    <bpmn:sequenceFlow id="Flow_Buyer_12" sourceRef="Task_SendRejection" targetRef="EndEvent_BuyerRejected"/>
  </bpmn:process>

  <bpmn:process id="Process_Supplier" name="Supplier order handling" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Supplier">
      <bpmn:lane id="Lane_Supplier" name="Supplier">
        <bpmn:flowNodeRef>StartEvent_Supplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceivePurchaseOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StockAvailability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOrderConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendRevisedOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AwaitBuyerDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendFinalConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveRejection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseOrderRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SupplierConfirmedDirect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SupplierConfirmedRevised</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_SupplierRejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Supplier" name="Order handling starts">
      <bpmn:outgoing>Flow_Supplier_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Task_ReceivePurchaseOrder" name="Receive purchase order" messageRef="Message_PurchaseOrder">
      <bpmn:incoming>Flow_Supplier_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplier_2</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Task_CheckStock" name="Check stock availability">
      <bpmn:incoming>Flow_Supplier_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplier_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_StockAvailability" name="All items available?">
      <bpmn:incoming>Flow_Supplier_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplier_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_Supplier_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendOrderConfirmation" name="Send order confirmation" messageRef="Message_OrderConfirmation">
      <bpmn:incoming>Flow_Supplier_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplier_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_SupplierConfirmedDirect" name="Order confirmed">
      <bpmn:incoming>Flow_Supplier_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_SendRevisedOffer" name="Send revised offer" messageRef="Message_RevisedOffer">
      <bpmn:incoming>Flow_Supplier_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplier_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_AwaitBuyerDecision" name="Await buyer decision">
      <bpmn:incoming>Flow_Supplier_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplier_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_Supplier_9</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="Task_ReceiveAcceptance" name="Receive acceptance" messageRef="Message_Acceptance">
      <bpmn:incoming>Flow_Supplier_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplier_10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Task_SendFinalConfirmation" name="Send final confirmation" messageRef="Message_FinalConfirmation">
      <bpmn:incoming>Flow_Supplier_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplier_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_SupplierConfirmedRevised" name="Order confirmed">
      <bpmn:incoming>Flow_Supplier_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Task_ReceiveRejection" name="Receive rejection" messageRef="Message_Rejection">
      <bpmn:incoming>Flow_Supplier_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplier_12</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Task_CloseOrderRequest" name="Close order request">
      <bpmn:incoming>Flow_Supplier_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Supplier_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_SupplierRejected" name="Order rejected">
      <bpmn:incoming>Flow_Supplier_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Supplier_1" sourceRef="StartEvent_Supplier" targetRef="Task_ReceivePurchaseOrder"/>
    <bpmn:sequenceFlow id="Flow_Supplier_2" sourceRef="Task_ReceivePurchaseOrder" targetRef="Task_CheckStock"/>
    <bpmn:sequenceFlow id="Flow_Supplier_3" sourceRef="Task_CheckStock" targetRef="Gateway_StockAvailability"/>
    <bpmn:sequenceFlow id="Flow_Supplier_4" name="All items available" sourceRef="Gateway_StockAvailability" targetRef="Task_SendOrderConfirmation"/>
    <bpmn:sequenceFlow id="Flow_Supplier_5" name="Some items unavailable" sourceRef="Gateway_StockAvailability" targetRef="Task_SendRevisedOffer"/>
    <bpmn:sequenceFlow id="Flow_Supplier_6" sourceRef="Task_SendOrderConfirmation" targetRef="EndEvent_SupplierConfirmedDirect"/>
    <bpmn:sequenceFlow id="Flow_Supplier_7" sourceRef="Task_SendRevisedOffer" targetRef="Gateway_AwaitBuyerDecision"/>
    <bpmn:sequenceFlow id="Flow_Supplier_8" name="Accepted" sourceRef="Gateway_AwaitBuyerDecision" targetRef="Task_ReceiveAcceptance"/>
    <bpmn:sequenceFlow id="Flow_Supplier_9" name="Rejected" sourceRef="Gateway_AwaitBuyerDecision" targetRef="Task_ReceiveRejection"/>
    <bpmn:sequenceFlow id="Flow_Supplier_10" sourceRef="Task_ReceiveAcceptance" targetRef="Task_SendFinalConfirmation"/>
    <bpmn:sequenceFlow id="Flow_Supplier_11" sourceRef="Task_SendFinalConfirmation" targetRef="EndEvent_SupplierConfirmedRevised"/>
    <bpmn:sequenceFlow id="Flow_Supplier_12" sourceRef="Task_ReceiveRejection" targetRef="Task_CloseOrderRequest"/>
    <bpmn:sequenceFlow id="Flow_Supplier_13" sourceRef="Task_CloseOrderRequest" targetRef="EndEvent_SupplierRejected"/>
  </bpmn:process>
</bpmn:definitions>
